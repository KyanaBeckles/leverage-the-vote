{
  "name": "Voter",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "middle_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "street_number": {
      "type": "string",
      "description": "Street/house number (St#)"
    },
    "street_name": {
      "type": "string",
      "description": "Street name"
    },
    "apt_number": {
      "type": "string",
      "description": "Apartment number"
    },
    "address": {
      "type": "string",
      "description": "Combined street address (street number + street name)"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "precinct": {
      "type": "string"
    },
    "party_affiliation": {
      "type": "string"
    },
    "voter_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "purged",
        "unknown"
      ],
      "default": "active"
    },
    "vote_count": {
      "type": "number",
      "description": "Number of election events this voter participated in (from MA Voter Activity file)"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "contact_status": {
      "type": "string",
      "enum": [
        "unknown",
        "not_home",
        "supportive",
        "undecided",
        "opposed",
        "signed"
      ],
      "default": "unknown"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "last_name"
  ]
}