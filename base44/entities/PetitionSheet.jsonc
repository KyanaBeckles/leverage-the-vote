{
  "name": "PetitionSheet",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "sheet_number": {
      "type": "string",
      "description": "Unique sheet identifier"
    },
    "pipeline_status": {
      "type": "string",
      "enum": [
        "blank_issued",
        "in_field",
        "returned",
        "scanned",
        "at_clerk",
        "certified",
        "rejected"
      ],
      "default": "blank_issued"
    },
    "assigned_to_member_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "issued_date": {
      "type": "string",
      "format": "date"
    },
    "returned_date": {
      "type": "string",
      "format": "date"
    },
    "scan_url_front": {
      "type": "string",
      "description": "URL of front scan (7 signature lines)"
    },
    "scan_url_back": {
      "type": "string",
      "description": "URL of back scan (17 signature lines)"
    },
    "scan_url": {
      "type": "string",
      "description": "Legacy single scan URL"
    },
    "raw_signature_count": {
      "type": "number",
      "default": 0
    },
    "certified_count": {
      "type": "number",
      "default": 0
    },
    "rejected_count": {
      "type": "number",
      "default": 0
    },
    "town_clerk": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "ai_processed": {
      "type": "boolean",
      "default": false
    },
    "ai_extracted_data": {
      "type": "string",
      "description": "JSON string of AI-extracted signer data"
    }
  },
  "required": [
    "campaign_id",
    "sheet_number"
  ]
}